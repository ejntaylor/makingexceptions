permalink: /
---

<section class="hero">
    <div class="wrap">
        <div class="hero-meta mono">
            <span>A podcast for builders</span>
            <span>Season 01</span>
            <span class="live">Recording now</span>
        </div>

        <div class="hero-stage">
            <h1 class="hero-title">
                <span>Making</span>
                <span><span class="ex">E</span>xceptions</span>
            </h1>

            <div class="sticker" aria-hidden="true">
                <svg viewBox="0 0 100 100">
                    <defs>
                        <path id="sticker-ring" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"/>
                    </defs>
                    <text><textPath href="#sticker-ring" textLength="236">Season 01 &#8226; On air soon &#8226; Season 01 &#8226; On air soon &#8226;</textPath></text>
                </svg>
                <span class="sticker-mark">e</span>
            </div>
        </div>

        <div class="hero-grid">
            <p class="hero-lede">Technical founders and engineering leaders on the journey from <span class="serif">code to company.</span></p>
            <div class="hero-side">
                <p>Long-form conversations about how they built what they built, the decisions that shaped them, and what they wish they'd known sooner.</p>
                <div>
                    <a href="/episodes/" class="btn btn-signal">Start listening <span aria-hidden="true">&rarr;</span></a>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="ticker" aria-hidden="true">
    <div class="ticker-track">
        {% for i in range(0, 2) %}
        <span>Founder journeys</span>
        <span>Engineering leadership</span>
        <span>Side projects &rarr; products</span>
        <span>Security</span>
        <span>AI</span>
        <span>Climate tech</span>
        <span>Fintech</span>
        <span>Hiring</span>
        <span>Shipping</span>
        {% endfor %}
    </div>
</div>

<section class="section section-dark">
    <div class="wrap">
        <p class="section-label mono">Why this show</p>
        <p class="manifesto">
            <span class="struck">Learn to code. Get promoted. Manage people. Repeat.</span>
            Some engineers break the loop and build companies instead. This show is about <span class="serif">the exceptions.</span>
        </p>
        <div class="manifesto-foot">
            <p>Not the pitch decks or the funding rounds. The actual work: the architecture call that shaped a company, the side project that became a product, the moment a builder realised they had to learn to lead.</p>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <p class="section-label mono">What we catch</p>
        <div class="catches">
            <div class="catch">
                <span class="catch-code mono">catch (<b>FounderJourney</b> $e)</span>
                <span class="catch-num">01</span>
                <h3>Founder journeys</h3>
                <p>How technical people build companies. The messy middle between writing code and running a business.</p>
            </div>
            <div class="catch">
                <span class="catch-code mono">catch (<b>Leadership</b> $e)</span>
                <span class="catch-num">02</span>
                <h3>Engineering leadership</h3>
                <p>When engineering decisions become business decisions. Architecture, hiring, shipping, and everything in between.</p>
            </div>
            <div class="catch">
                <span class="catch-code mono">catch (<b>SideProject</b> $e)</span>
                <span class="catch-num">03</span>
                <h3>Side projects to products</h3>
                <p>The leap from weekend hack to real revenue. What it takes and what it costs.</p>
            </div>
            <div class="catch">
                <span class="catch-code mono">catch (<b>DeepDive</b> $e)</span>
                <span class="catch-num">04</span>
                <h3>Industry deep dives</h3>
                <p>Security, AI, climate tech, fintech. Technical founders building in the spaces that matter.</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <p class="section-label mono">Stack trace &middot; latest episodes</p>
        {% set traceEpisodes = collections.episodes | limit(5) %}
        {% include "partials/trace.njk" %}
        <div class="trace-foot">
            <p class="mono">{% if collections.episodes.length > 0 %}{{ collections.episodes.length }} frames and counting{% else %}// first episodes land soon{% endif %}</p>
            <a href="/episodes/" class="btn btn-ghost">All episodes <span aria-hidden="true">&rarr;</span></a>
        </div>
    </div>
</section>

