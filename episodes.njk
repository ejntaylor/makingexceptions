---
title: "Episodes"
metaDescription: "All episodes of Making Exceptions — conversations with technical founders and engineering leaders."
layout: layouts/base.njk
permalink: /episodes/
---

<section class="page-header">
    <div class="wrap">
        <span class="mono">Stack trace &middot; {{ collections.episodes.length }} episode{% if collections.episodes.length != 1 %}s{% endif %}</span>
        <h1 class="page-title">Episodes</h1>
        <p class="page-intro">Conversations with the people building what's next. Newest frame first.</p>
    </div>
</section>

<section class="section">
    <div class="wrap">
        {% if collections.episodes.length > 0 %}
        {% set traceEpisodes = collections.episodes %}
        {% include "partials/trace.njk" %}
        {% else %}
        <div class="empty">
            <div class="empty-head mono">
                <span><span class="err">EpisodeNotFoundException</span></span>
                <span>episodes.njk:1</span>
            </div>
            <div class="empty-body">
                <h2>Nothing's thrown yet. The first batch is recording now.</h2>
                <p>Season 01 is in production. Follow along on <a href="https://linkedin.com/in/{{ site.author.social.linkedin }}" target="_blank" rel="noopener">LinkedIn</a> or <a href="https://x.com/{{ site.author.social.twitter }}" target="_blank" rel="noopener">X</a> to hear the moment it drops.</p>
                <p class="empty-trace mono">
                    #0 <b>Studio::record()</b> in progress<br>
                    #1 <b>Edit::cut()</b> queued<br>
                    #2 <b>Feed::publish()</b> queued
                </p>
            </div>
        </div>
        {% endif %}
    </div>
</section>

{% include "partials/listen.njk" %}
