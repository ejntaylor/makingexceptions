---
title: "Episodes"
metaDescription: "All episodes of Making Exceptions — conversations with technical founders and engineering leaders."
layout: layouts/base.njk
permalink: /episodes/
---

<section class="page-header">
    <div class="container-wide">
        <h1>Episodes</h1>
        <p>Conversations with the people building what's next.</p>
    </div>
</section>

<section class="section">
    <div class="container-wide">
        {% if collections.episodes.length > 0 %}
        <div class="episode-list">
            {% for episode in collections.episodes %}
            <a href="{{ episode.url }}" class="episode-card">
                <span class="episode-card-number">EP {{ episode.data.episodeNumber }}</span>
                <h3 class="episode-card-title">{{ episode.data.title }}</h3>
                {% if episode.data.guest %}
                <p class="episode-card-guest">with {{ episode.data.guest }}</p>
                {% endif %}
                <p class="episode-card-description">{{ episode.data.description }}</p>
                <span class="episode-card-meta">{{ episode.data.date | dateFormat }}{% if episode.data.duration %} / {{ episode.data.duration | duration }}{% endif %}</span>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            <p class="empty-state-icon">&#127911;</p>
            <h2>Episodes are on the way</h2>
            <p>We're recording the first batch of conversations now. Check back soon, or follow along on <a href="https://linkedin.com/in/{{ site.author.social.linkedin }}" target="_blank" rel="noopener">LinkedIn</a> for updates.</p>
        </div>
        {% endif %}
    </div>
</section>
