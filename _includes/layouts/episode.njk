---
layout: layouts/base.njk
---

<article>
    <header class="episode-hero">
        <div class="wrap">
            <div class="episode-top mono">
                <a href="/episodes/">&larr; Stack trace</a>
                <time datetime="{{ date | isoDate }}">{{ date | dateFormat }}{% if duration %} &middot; {{ duration | duration }}{% endif %}</time>
            </div>

            <span class="episode-number-big" aria-label="Episode {{ episodeNumber }}">#{{ episodeNumber | pad }}</span>
            <h1 class="episode-title">{{ title }}</h1>
            {% if guest %}
            <p class="episode-guest">with {{ guest }}{% if guestRole %}<small>{{ guestRole }}</small>{% endif %}</p>
            {% endif %}

            <div class="episode-bar">
                <span class="mono">Listen on</span>
                {% if spotifyUrl %}<a href="{{ spotifyUrl }}" class="btn btn-signal" target="_blank" rel="noopener">Spotify</a>{% endif %}
                {% if appleUrl %}<a href="{{ appleUrl }}" class="btn" target="_blank" rel="noopener">Apple Podcasts</a>{% endif %}
                {% if youtubeUrl %}<a href="{{ youtubeUrl }}" class="btn" target="_blank" rel="noopener">YouTube</a>{% endif %}
            </div>
        </div>
    </header>

    <section class="section">
        <div class="wrap prose-grid">
            <aside class="prose-aside mono">
                <div class="sticky">
                    <span>Episode {{ episodeNumber }}</span>
                    {% if guest %}<span>{{ guest }}</span>{% endif %}
                </div>
            </aside>

            <div class="prose">
                {% if description %}<p class="lead">{{ description }}</p>{% endif %}
                {{ content | safe }}
            </div>
        </div>
    </section>
</article>

{% include "partials/listen.njk" %}
