<header class="site-header">
    <div class="container-wide header-inner">
        <a href="/" class="logo">making <span class="logo-exception">e</span>xceptions</a>
        <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <nav class="nav-links" aria-label="Main navigation">
            {% for item in navigation %}
            <a href="{{ item.url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
        </nav>
    </div>
</header>
