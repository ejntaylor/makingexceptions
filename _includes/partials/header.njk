<header class="site-header">
    <div class="wrap header-inner">
        <a href="/" class="logo" aria-label="{{ site.name }} — home">making <span class="ex">e</span>xceptions</a>
        <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">Menu</button>
        <nav class="nav-links" aria-label="Main navigation">
            {% for item in navigation %}
            <a href="{{ item.url }}"{% if item.cta %} class="nav-cta"{% endif %}{% if item.external %} target="_blank" rel="noopener"{% endif %}{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
        </nav>
    </div>
</header>
